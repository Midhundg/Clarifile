# Clarifile Configuration
# Rename this file to .env and supply your credentials

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.8-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Sentence Transformers Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Persistent ChromaDB Directory Path (Relative or Absolute)
CHROMA_PERSIST_DIR=data/chroma_db

# ChromaDB Collection Name
CHROMA_COLLECTION_NAME=clarifile_documents

# Chunking Configuration
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150

# Retrieval Configuration
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.25

# Upload Limit in Megabytes
MAX_FILE_SIZE_MB=25
